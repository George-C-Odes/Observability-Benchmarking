# Dependencies & build output (rebuilt inside Docker)
node_modules
.next
coverage

# VCS
.git
.gitignore

# Documentation (excluded by glob, README re-included below isn't needed at runtime)
*.md

# Local env overrides
.env*.local

# Debug / error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker meta (prevent recursive context)
Dockerfile
.dockerignore

# TypeScript incremental build info (the native checker runs fresh in Docker)
tsconfig.tsbuildinfo

# Vitest report artifacts
vitest-*-report.json

# CI quality report (generated in GitHub Actions, not part of the app)
quality-report
oxlint-report.json
oxfmt-output.txt
typescript-output.txt

# Temp / scratch
.tmp

# Include the SSE smoke helper for quality-stage request-boundary tests.
# The builder copies only app/lib/public, so scripts stay out of the runtime image.
scripts/*
!scripts/sse-smoke.mjs
!scripts/coverage-gate.mjs
