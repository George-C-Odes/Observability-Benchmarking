{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "automerge": false,
  "ignoreScripts": true,
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "prConcurrentLimit": 5,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^compose\\/\\.env$/"
      ],
      "matchStrings": [
        "(?<nodeStart>^|\\r?\\n)(?<nodePrefix>NODE_MAJOR_VERSION:[ \\t]*)(?<nodeMajor>\\d+)(?<nodeBetween>[ \\t]*\\r?\\nNODE_MINOR_PATCH_VERSION:[ \\t]*)(?<nodeMinorPatch>\\d+\\.\\d+)(?<nodeEnd>[ \\t]*(?:\\r?\\n|$))"
      ],
      "currentValueTemplate": "{{{nodeMajor}}}.{{{nodeMinorPatch}}}",
      "autoReplaceStringTemplate": "{{{nodeStart}}}{{{nodePrefix}}}{{{newMajor}}}{{{nodeBetween}}}{{{newMinor}}}.{{{newPatch}}}{{{nodeEnd}}}",
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\/\\.env$/"],
      "matchStrings": ["(?:^|\\r?\\n)SPRING_BOOT_VERSION:[ \\t]*(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "org.springframework.boot:spring-boot-dependencies",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\/\\.env$/"],
      "matchStrings": ["(?:^|\\r?\\n)QUARKUS_VERSION:[ \\t]*(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "io.quarkus.platform:quarkus-bom",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\/\\.env$/"],
      "matchStrings": ["(?:^|\\r?\\n)MICRONAUT_VERSION:[ \\t]*(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "io.micronaut:micronaut-core-bom",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\/\\.env$/"],
      "matchStrings": ["(?:^|\\r?\\n)HELIDON_VERSION:[ \\t]*(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "io.helidon:helidon-bom",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\/\\.env$/"],
      "matchStrings": ["(?:^|\\r?\\n)SPARK_VERSION:[ \\t]*(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "org.zoomba-lang:spark-core",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\/\\.env$/"],
      "matchStrings": ["(?:^|\\r?\\n)JAVALIN_VERSION:[ \\t]*(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "io.javalin:javalin",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\/\\.env$/"],
      "matchStrings": ["(?:^|\\r?\\n)DROPWIZARD_VERSION:[ \\t]*(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "io.dropwizard:dropwizard-dependencies",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\/\\.env$/"],
      "matchStrings": ["(?:^|\\r?\\n)VERTX_VERSION:[ \\t]*(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "io.vertx:vertx-stack-depchain",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\/\\.env$/"],
      "matchStrings": ["(?:^|\\r?\\n)PEKKO_VERSION:[ \\t]*(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "org.apache.pekko:pekko-http_3",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\/\\.env$/"],
      "matchStrings": ["(?:^|\\r?\\n)PEKKO_CORE_VERSION:[ \\t]*(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "org.apache.pekko:pekko-stream_3",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\/\\.env$/"],
      "matchStrings": ["(?:^|\\r?\\n)GO_VERSION:[ \\t]*(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\/\\.env$/"],
      "matchStrings": ["(?:^|\\r?\\n)PYTHON_VERSION:[ \\t]*(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "python/cpython",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\/\\.env$/"],
      "matchStrings": ["(?:^|\\r?\\n)DJANGO_VERSION:[ \\t]*(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "django",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^services\\/python\\/django\\/qodana\\.yaml$/"],
      "matchStrings": [
        "linter:\\s+(?<depName>jetbrains/qodana-python-community):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.venv/**",
    ".tmp/**",
    "tmp/**",
    "data/**",
    "_site/**",
    "docs/_site/**",
    "my-agent/apm_modules/**"
  ],
  "packageRules": [
    {
      "description": "Node Docker tag versions follow the paired env pin; retain digest refreshes.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "utils/nextjs-dash/Dockerfile"
      ],
      "matchPackageNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin"
      ],
      "enabled": false
    },
    {
      "description": "Node CI versions are generated from compose/.env.",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/**",
        ".github/actions/**"
      ],
      "matchDepNames": [
        "node"
      ],
      "enabled": false
    },
    {
      "description": "Locally built images follow the shared framework/runtime tag formatter.",
      "matchManagers": [
        "docker-compose"
      ],
      "matchFileNames": [
        "compose/docker-compose.yml",
        "compose/utils.yml"
      ],
      "matchPackageNames": [
        "/^spring-/",
        "/^quarkus-/",
        "/^micronaut-/",
        "/^helidon-/",
        "/^spark-/",
        "/^javalin-/",
        "/^dropwizard-/",
        "vertx-jvm",
        "pekko-jvm",
        "go",
        "go-simple",
        "django-platform",
        "django-reactive",
        "nextjs-dash",
        "orchestrator"
      ],
      "enabled": false
    },
    {
      "description": "Framework/runtime PRs update only compose/.env; the Framework Version Sync workflow relays them before merge.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["compose/.env"],
      "addLabels": ["framework-version"],
      "rebaseWhen": "behind-base-branch",
      "prBodyNotes": ["compose/.env is authoritative. Framework Version Sync commits the generated manifests, locks, IDE configurations, and documentation to this PR."],
      "ignoreUnstable": true
    },
    {
      "description": "These Maven versions are generated from compose/.env; keep unrelated libraries/plugins independently managed.",
      "matchManagers": ["maven"],
      "matchFileNames": ["services/java/**/pom.xml", "utils/orchestrator/pom.xml"],
      "matchPackageNames": [
        "/^org\\.springframework\\.boot:/",
        "io.quarkus.platform:quarkus-bom",
        "io.quarkus.platform:quarkus-maven-plugin",
        "io.quarkus:quarkus-maven-plugin",
        "io.quarkus:quarkus-extension-processor",
        "io.micronaut:micronaut-core-bom",
        "io.micronaut:micronaut-inject-java",
        "io.helidon:helidon-bom",
        "org.zoomba-lang:spark-core",
        "io.javalin:javalin",
        "io.dropwizard:dropwizard-dependencies",
        "io.vertx:vertx-stack-depchain",
        "org.apache.pekko:pekko-http_3",
        "org.apache.pekko:pekko-stream_3",
        "org.apache.pekko:pekko-slf4j_3"
      ],
      "enabled": false
    },
    {
      "description": "Go directives/toolchains follow GO_VERSION; Go library updates remain enabled.",
      "matchManagers": ["gomod"],
      "matchFileNames": ["services/go/**/go.mod", ".github/go-tools/go.mod"],
      "matchDepTypes": ["golang"],
      "enabled": false
    },
    {
      "description": "Go/Python Docker tag versions follow the env ARG defaults; retain digest updates and other base images.",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["services/go/**/Dockerfile", "services/python/django/**/Dockerfile"],
      "matchPackageNames": ["golang", "python"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"],
      "enabled": false
    },
    {
      "description": "Django inputs and generated locks follow DJANGO_VERSION, not independent pip updates.",
      "matchManagers": ["pip_requirements", "pip-compile"],
      "matchFileNames": ["services/python/django/**", ".github/requirements/**"],
      "matchPackageNames": ["django"],
      "enabled": false
    },
    {
      "description": "Let registry releases age before updating; do not apply this to Docker or action digests.",
      "matchDatasources": [
        "npm",
        "pypi",
        "maven",
        "go",
        "golang-version",
        "node-version",
        "rubygems"
      ],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-required"
    },
    {
      "description": "Let CPython releases age without delaying unrelated GitHub Action version updates.",
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["python/cpython"],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-required"
    },
    {
      "description": "Require opt-in for major upgrades so benchmark compatibility can be reviewed before CI runs.",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Java/GraalVM versions are manually pinned in compose/.env; retain image digest refreshes.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "services/java/**/Dockerfile",
        "utils/orchestrator/Dockerfile"
      ],
      "matchPackageNames": [
        "eclipse-temurin",
        "amazoncorretto",
        "container-registry.oracle.com/graalvm/native-image",
        "ghcr.io/graalvm/native-image-community",
        "gcr.io/distroless/java*"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin"
      ],
      "enabled": false
    },
    {
      "description": "GraalVM SVM follows the manually managed Java runtime pin.",
      "matchManagers": [
        "maven"
      ],
      "matchFileNames": [
        "services/java/helidon/mp/native/pom.xml"
      ],
      "matchPackageNames": [
        "org.graalvm.nativeimage:svm"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": "0 days"
  }
}
