{
  "name": "nextjs-dash",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001 -H 0.0.0.0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.config.node.ts && vitest run -c vitest.config.dom.ts",
    "test:node": "vitest run -c vitest.config.node.ts",
    "test:dom": "vitest run -c vitest.config.dom.ts",
    "test:fast": "vitest run -c vitest.config.node.ts --bail=1 && vitest run -c vitest.config.dom.ts --bail=1",
    "test:watch": "vitest -c vitest.config.dom.ts",
    "test:coverage": "vitest run -c vitest.config.node.ts --coverage && vitest run -c vitest.config.dom.ts --coverage",
    "test:coverage:node": "vitest run -c vitest.config.node.ts --coverage",
    "test:coverage:dom": "vitest run -c vitest.config.dom.ts --coverage"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "9.4.0",
    "date-fns": "4.4.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/xml2js": "0.4.14",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "^30.1.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
