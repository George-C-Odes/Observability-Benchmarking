{
  "name": "nextjs-dash",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.2.2",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001 -H 0.0.0.0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.config.node.mts && vitest run -c vitest.config.dom.mts",
    "test:node": "vitest run -c vitest.config.node.mts",
    "test:dom": "vitest run -c vitest.config.dom.mts",
    "test:fast": "vitest run -c vitest.config.node.mts --bail=1 && vitest run -c vitest.config.dom.mts --bail=1",
    "test:watch": "vitest -c vitest.config.dom.mts",
    "test:coverage": "vitest run -c vitest.config.node.mts --coverage && vitest run -c vitest.config.dom.mts --coverage",
    "test:coverage:node": "vitest run -c vitest.config.node.mts --coverage",
    "test:coverage:dom": "vitest run -c vitest.config.dom.mts --coverage"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^31.0.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
