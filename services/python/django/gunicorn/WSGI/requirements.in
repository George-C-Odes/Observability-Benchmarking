# ------------------------------------------------------------------
# requirements.in  — top-level dependencies for pip-compile
#
# Usage: compile requirements.txt only in the Linux container, from the repo root:
#   pwsh -NoProfile -File .github/requirements/python-ci.ps1 -Action UpgradeDjango
# (IntelliJ: "[upgrade] Django G"). A host pip-compile, especially on Windows,
# changes the header/options and adds Windows-only pins such as tzdata.
# See .github/requirements/README.md.
#
# Only list *direct* dependencies here.  pip-compile resolves the
# full dependency tree and pins every version in requirements.txt.
# ------------------------------------------------------------------

# Django 6.x — WSGI framework
Django==6.1.3

# WSGI server — gthread worker for max throughput on 2 vCPUs
gunicorn==27.0.1

